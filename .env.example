# Copy this file to `.env` and fill in the values from your Supabase project.
# Anything prefixed with VITE_ is read by the browser bundle, so never put
# service-role keys here — the anon/publishable key is safe on the client.

# --- Supabase (frontend reads these via import.meta.env) ---
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# --- Supabase (server-side, used by the CLI when linking/deploying) ---
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# --- VirusTotal ---
# Only kept here for local reference. In production the real key is stored as
# a Supabase edge-function secret (see supabase/functions/*) so it never ships
# to the browser.
VITE_VIRUSTOTAL_API_KEY="your-virustotal-api-key"
